# Database connection. Use a least-privileged SQL login outside local development.
DB_HOST=localhost
DB_INSTANCE=
DB_PORT=1433
DB_USERNAME=pricify_app_user
DB_PASSWORD=change-me
DB_DATABASE=pricify_db
DB_SYNCHRONIZE=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication. JWT_SECRET is sensitive and must be unique per environment.
JWT_SECRET=change-me-to-a-long-random-secret

# First-run seed admin. Leave email/password blank after the first administrator exists.
INTERNAL_TENANT_NAME=Internal Pricify
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Internal
INITIAL_ADMIN_LAST_NAME=Admin

# Optional local reset/seed script users. Passwords are sensitive and are never printed.
RESET_DB_ADMIN_EMAIL=admin@example.test
RESET_DB_ADMIN_PASSWORD=
RESET_DB_COMMERCIAL_EMAIL=commercial@example.test
RESET_DB_COMMERCIAL_PASSWORD=

# Application URLs.
FRONTEND_URL=http://localhost:5173
